<Window x:Class="ModelCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModelCreator — Tekla Structures 2026"
        Width="750" Height="520" MinWidth="720" MinHeight="490"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Create Tekla model" FontSize="23" FontWeight="SemiBold"
                   Foreground="#19324C" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="Tekla Structures 2026  •  SEVERFIELD_Model_Template"
                   Foreground="#596879" Margin="0,0,0,22"/>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contract number" VerticalAlignment="Center"/>
            <TextBox x:Name="ContractNumberInput" Grid.Column="1" Height="30" Text="C1234"
                     VerticalContentAlignment="Center" Padding="7,0" TextChanged="InputsChanged"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Project name" VerticalAlignment="Center"/>
            <TextBox x:Name="ProjectNameInput" Grid.Column="1" Height="30" Text="test model"
                     VerticalContentAlignment="Center" Padding="7,0" TextChanged="InputsChanged"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Model name" VerticalAlignment="Center"/>
            <TextBox x:Name="ModelNamePreview" Grid.Column="1" Height="30" IsReadOnly="True"
                     Background="#E9EDF2" VerticalContentAlignment="Center" Padding="7,0"/>
        </Grid>
        <StackPanel Grid.Row="5">
            <TextBlock Text="Tekla 2026 • UK environment • SEVERFIELD role"
                       FontWeight="SemiBold" Foreground="#19324C" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Licence" Width="155" VerticalAlignment="Center"/>
                <ComboBox x:Name="LicenseSelector" Width="170" Height="30" SelectedIndex="0">
                    <ComboBoxItem Content="Diamond" Tag="DIAMOND"/>
                    <ComboBoxItem Content="Carbon" Tag="CARBON"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="DestinationPreview" TextWrapping="Wrap" Foreground="#536478"/>
            <TextBlock x:Name="StatusMessage" Margin="0,18,0,0" TextWrapping="Wrap"
                       Foreground="#9A3A29"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryPropertiesButton" Content="Apply to Open Model"
                    MinWidth="175" Height="36" Padding="12,6" Margin="0,0,12,0"
                    Click="RetryPropertiesButton_Click"/>
            <Button x:Name="CreateFoldersButton" Content="Create Test Folders"
                    MinWidth="145" Height="36" Padding="10,6" Margin="0,0,12,0"
                    Click="CreateFoldersButton_Click"/>
            <Button x:Name="ConnectTestButton" Content="Create Connect Project"
                    MinWidth="165" Height="36" Padding="12,6" Margin="0,0,12,0"
                    Click="ConnectTestButton_Click"/>
            <Button x:Name="CreateButton" Content="Create Model"
                    MinWidth="145" Height="36" Padding="15,6"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
